JWT_SECRET=replace_with_a_long_random_secret
CLIENT_URL=http://127.0.0.1:8080
CLIENT_PROXY_URL=http://localhost:8080
PORT=5000
NODE_ENV=dev
EMAIL_SERVICE_URL=https://tsp-emailservice.vercel.app/email
EMAIL_SERVICE_AUTH_TOKEN=your_email_service_auth_token
# above environment variables can be used as it is,
# if you are not making changing the port
MONGO_URL=mongodb://openlogo:local_dev_only_password@mongodb:27017/openlogo?authSource=admin
# if you using dockercompose then no changes are requried for MONGO_URL

# Below environment variables are only requried,
# if you are using business APIs. 
ACCESS_KEY=your_aws_access_key_id
SECRET_ACCESS_KEY=your_aws_secret_access_key
BUCKET_NAME=AWS_bucket_name
BUCKET_REGION=AWS_region
DISTRIBUTION_DOMAIN=https://your_distribution_id.cloudfront.net
DISTRIBUTION_ID=CloudFront_Distribution_ID
CLOUD_FRONT_KEYPAIR_ID=your_cloudfront_keypair_id
CLOUD_FRONT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----RSA KEY FOR CLOUDFRONT=-----END RSA PRIVATE KEY-----
BUCKET_KEY=s3_bucket_folder_name_can_customise_as_per_your_likings
ADMINSEMAILS=admin_Email@gmail.com
CRYPTO_KEY=your-32-byte-key-hex-encoded
